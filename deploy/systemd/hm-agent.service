[Unit]
Description=hypermon host agent
Documentation=https://github.com/iksteen/hypermon
After=network-online.target libvirtd.service virtqemud.service ovn-controller.service
Wants=network-online.target

[Service]
EnvironmentFile=/etc/hypermon/agent.env
ExecStart=/usr/local/bin/hm-agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
