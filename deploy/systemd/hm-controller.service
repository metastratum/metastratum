[Unit]
Description=hypermon controller
Documentation=https://github.com/iksteen/hypermon/blob/main/docs/operations.md
After=network-online.target
Wants=network-online.target

[Service]
# DATABASE_URL, HM_MASTER_KEY_FILE, HM_OVN_NB, HM_LISTEN, ... (see
# `hm-controller serve --help`). Keep this file and the master key readable
# by root only.
EnvironmentFile=/etc/hypermon/controller.env
ExecStart=/usr/local/bin/hm-controller serve
Restart=always
RestartSec=5
DynamicUser=yes
# The master key, OVN client key and so on are passed in as credentials,
# readable by this service only, e.g.:
#   LoadCredential=master.key:/etc/hypermon/master.key
#   Environment=HM_MASTER_KEY_FILE=%d/master.key
# Fencing hosts that are VMs on this machine (libvirt fencing) needs its
# libvirt socket:
#   SupplementaryGroups=libvirt

# The controller writes nothing locally.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
