[Unit]
Description=metastratum host agent
Documentation=https://github.com/metastratum/metastratum/blob/main/docs/getting-started.md
After=network-online.target libvirtd.service virtqemud.service ovn-controller.service
Wants=network-online.target

[Service]
# Settings: /etc/metastratum/agent.toml (see deploy/config/agent.toml).
ExecStart=/usr/bin/mst-agent
Restart=always
RestartSec=5
# Files it makes (VMs' disks, cached images, cloud-init seeds holding user
# data) are root's alone; libvirt hands each VM's files to its QEMU.
UMask=0077

[Install]
WantedBy=multi-user.target
