[Unit]
Description=metastratum controller
Documentation=https://github.com/metastratum/metastratum/blob/main/docs/operations/README.md
After=network-online.target
Wants=network-online.target

[Service]
# The settings (see deploy/config/controller.toml) and the master key beside
# them are passed in as credentials, readable by this service only. Keep
# both readable by root only on disk.
LoadCredential=controller.toml:/etc/metastratum/controller.toml
LoadCredential=master.key:/etc/metastratum/master.key
ExecStart=/usr/bin/mst-controller --config %d/controller.toml serve
Restart=always
RestartSec=5
DynamicUser=yes
# Fencing hosts that are VMs on this machine (libvirt fencing) needs its
# libvirt socket:
#   SupplementaryGroups=libvirt

# The controller writes nothing locally.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
